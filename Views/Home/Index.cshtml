@{
    ViewData["Title"] = "MediFlow";
}

<div class="hero">

    <div class="hero-content">

        <span class="badge">
            CLINIC APPOINTMENT MANAGEMENT
        </span>

        <h1>
            Healthcare appointments,
            <span>made simple.</span>
        </h1>

        <p>
            Book your clinic appointment online,
            manage your bookings and keep your
            healthcare schedule organised.
        </p>

        <div class="hero-buttons">

            <a asp-controller="Account"
               asp-action="Login"
               class="btn-primary">
                Sign In
            </a>

            <a asp-controller="Account"
               asp-action="Register"
               class="btn-secondary">
                Create Account
            </a>

        </div>

    </div>

    <div class="hero-card">

        <div class="medical-icon">
            +
        </div>

        <h3>MediFlow</h3>

        <p>
            Your clinic appointment,
            simplified.
        </p>

        <div class="mini-stat">
            <strong>24/7</strong>
            <span>Easy booking</span>
        </div>

        <div class="mini-stat">
            <strong>✓</strong>
            <span>Secure records</span>
        </div>

    </div>

</div>